#cloud-config
# First boot only. Player allowlists are not in this file: Linode marks
# metadata user_data ForceNew, so editing it would replace the VM.
hostname: ${hostname_short}
fqdn: ${fqdn}
manage_etc_hosts: true
timezone: UTC
package_update: true
package_upgrade: true
packages:
  - docker.io
  - git
  - rclone
  - unattended-upgrades
  - apt-listchanges
  - ca-certificates
  - curl
  - e2fsprogs
ssh_pwauth: false
disable_root: false
users:
  - default
  - name: ${sudo_user}
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
%{ for key in ssh_public_keys ~}
      - "${key}"
%{ endfor ~}
write_files:
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      APT::Periodic::AutocleanInterval "7";
  - path: /etc/apt/apt.conf.d/52unattended-upgrades-local
    permissions: "0644"
    content: |
      Unattended-Upgrade::Automatic-Reboot "false";
      Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
      Unattended-Upgrade::Remove-Unused-Dependencies "true";
  - path: /usr/local/sbin/luanti-host-bootstrap
    permissions: "0755"
    content: |
      ${indent(6, chomp(host_bootstrap))}
runcmd:
  - [/usr/local/sbin/luanti-host-bootstrap, "${volume_label}", "${sudo_user}"]
