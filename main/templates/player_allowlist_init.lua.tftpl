-- Private-server join allowlist.
-- Generated by Terraform. The next apply overwrites this file.
-- Player names are case-sensitive and must match what the client sends.

local DROP_PATH = "/var/lib/minetest/password-drop/pending"
local RESULT_PATH = "/var/lib/minetest/password-drop/pending.result"

local allowed = {
%{ for name in names ~}
  ["${name}"] = true,
%{ endfor ~}
}

local function allowed_count()
  local n = 0
  for _ in pairs(allowed) do
    n = n + 1
  end
  return n
end

local ie = core.request_insecure_environment()

core.log("action", "[player_allowlist] loaded " .. tostring(allowed_count()) .. " name(s)")
if ie == nil then
  core.log("error", "[player_allowlist] insecure environment denied; password drop disabled")
else
  core.log("action", "[player_allowlist] password drop enabled")
end

core.register_on_prejoinplayer(function(name, ip)
  if allowed[name] then
    return nil
  end
  core.log("action", "[player_allowlist] rejected name '" .. tostring(name) .. "' from " .. tostring(ip))
  return "This server is private. Your player name is not on the allowlist."
end)

local admin_privs = {
  interact = true,
  shout = true,
  basic_privs = true,
  privs = true,
  server = true,
  ban = true,
  kick = true,
  teleport = true,
  bring = true,
  settime = true,
  protection_bypass = true,
  give = true,
  password = true,
  fly = true,
  fast = true,
  noclip = true,
  rollback = true,
  debug = true,
}

local function write_result(text)
  local handle = ie.io.open(RESULT_PATH, "w")
  if handle == nil then
    core.log("error", "[player_allowlist] could not write password result")
    return
  end
  handle:write(text)
  if text:sub(-1) ~= "\n" then
    handle:write("\n")
  end
  handle:close()
end

local function consume_password_drop()
  if ie == nil then
    return
  end
  local handle = ie.io.open(DROP_PATH, "r")
  if handle == nil then
    return
  end
  local line = handle:read("*l")
  handle:close()
  ie.os.remove(DROP_PATH)

  if line == nil or line == "" then
    write_result("error empty drop")
    return
  end

  local name, password = line:match("^([%w_%-]+)\t(.+)$")
  if name == nil or password == nil or password == "" then
    write_result("error bad drop format")
    return
  end
  if #password > 128 then
    write_result("error password too long")
    return
  end

  local hash = core.get_password_hash(name, password)
  local ok = core.set_player_password(name, hash)
  if not ok then
    write_result("error set_player_password failed for " .. name)
    return
  end

  local admin_name = core.settings:get("name") or ""
  if name == admin_name and admin_name ~= "" then
    local priv_ok, priv_err = pcall(core.set_player_privs, name, admin_privs)
    if not priv_ok then
      core.log("error", "[player_allowlist] admin privs failed: " .. tostring(priv_err))
      write_result("error password set but privs failed for " .. name)
      return
    end
  end

  core.log("action", "[player_allowlist] set password for '" .. name .. "'")
  write_result("ok " .. name)
end

local accum = 0
core.register_globalstep(function(dtime)
  accum = accum + dtime
  if accum < 1 then
    return
  end
  accum = 0
  consume_password_drop()
end)
